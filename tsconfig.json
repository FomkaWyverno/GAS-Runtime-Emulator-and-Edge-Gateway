{
"compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true
  },

  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  }
}
