{
"compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["jest", "node"],
    "esModuleInterop": true,
    "strict": true,
    "outDir": "./dist",
    //"rootDir": "./src",
    "skipLibCheck": true
  },

  "include": [
    "src/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
  ]
}
