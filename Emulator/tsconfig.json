{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [
      "jest",
      "node"
    ],
    "esModuleInterop": true,
    "strict": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "tsup.config.ts",
    "fix-imports.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}